rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Subjects collection for categories
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if true;
    }

    // Questions collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    // Global settings and configs
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Atomic voucher counter
    match /counters/{counterId} {
      allow read: if true;
      allow write: if true;
    }

    // Submissions record from all users
    match /submissions/{submissionId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
